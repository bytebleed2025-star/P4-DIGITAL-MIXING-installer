      --text-main: #eef1f8;
      --text-dim: #8b93a7;

      --accent-eq: #fb923c;
      --accent-eq-glow: rgba(251, 146, 60, 0.38);
      --accent-route: #38bdf8;
      --accent-route-glow: rgba(56, 189, 248, 0.38);
      --accent-reverb: #c084fc;
      --accent-reverb-glow: rgba(192, 132, 252, 0.38);
      --accent-comp: #34d399;
      --accent-comp-glow: rgba(52, 211, 153, 0.38);
      --accent-master: #fbbf24;
      --accent-master-glow: rgba(251, 191, 36, 0.38);

      --danger: #f87171;
      --success: #34d399;

      --radius-lg: 20px;
      --radius-md: 14px;
      --radius-sm: 9px;

      --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      --font-mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    }

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background-color: var(--bg-base);
      background-image:
        radial-gradient(900px 500px at 8% -10%, rgba(56, 189, 248, 0.10), transparent 60%),
        radial-gradient(800px 500px at 92% 110%, rgba(192, 132, 252, 0.09), transparent 60%),
        linear-gradient(180deg, var(--bg-base), var(--bg-deep));
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      font-size: 14px;
      display: flex;
      flex-direction: column;
      font-feature-settings: "tnum" 1;
    }

    ::-webkit-scrollbar { width: 9px; height: 9px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.10); border-radius: 999px; border: 2px solid transparent; background-clip: padding-box; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.20); background-clip: padding-box; }

    :focus-visible { outline: 2px solid var(--accent-route); outline-offset: 2px; }

    /* ---------- Header ---------- */
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      height: 64px;
      padding: 0 20px;
      background: rgba(7, 8, 13, 0.72);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.9);
    }

    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; overflow: hidden; }

    .brand-icon {
      width: 36px;
      height: 36px;
      flex: 0 0 auto;
      border-radius: 11px;
      background: linear-gradient(140deg, var(--accent-route), var(--accent-reverb) 70%);
      color: #05060a;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 22px rgba(56, 189, 248, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }
    .brand-icon svg { width: 20px; height: 20px; }

    .brand-text { line-height: 1.25; min-width: 0; }
    .brand-text .title {
      font-weight: 750;
      font-size: 0.98rem;
      letter-spacing: 0.01em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .brand-text .subtitle {
      font-size: 0.62rem;
      color: var(--text-dim);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-family: var(--font-mono);
      font-weight: 600;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 13px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      font-size: 0.7rem;
      font-family: var(--font-mono);
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
      flex: 0 0 auto;
    }
    .status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; background: var(--text-dim); }
    .status.ws-connected { color: var(--success); border-color: rgba(52, 211, 153, 0.3); background: rgba(52, 211, 153, 0.08); }
    .status.ws-connected::before { background: var(--success); box-shadow: 0 0 10px var(--success); animation: pulse 2s infinite; }
    .status.ws-disconnected { color: var(--danger); border-color: rgba(248, 113, 113, 0.3); background: rgba(248, 113, 113, 0.07); }
    .status.ws-disconnected::before { background: var(--danger); box-shadow: 0 0 10px var(--danger); }

    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }

    /* ---------- Channel Quick-Nav ---------- */
    .channel-nav {
      position: sticky;
      top: 64px;
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: rgba(9, 10, 16, 0.68);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .channel-nav::-webkit-scrollbar { display: none; }

    .ch-pill {
      flex: 0 0 auto;
      height: 36px;
      min-width: 36px;
      padding: 0 9px;
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--ch-accent, #94a3b8) 45%, transparent);
      background: rgba(255, 255, 255, 0.03);
      color: var(--ch-accent, var(--text-main));
      font-size: 0.78rem;
      font-weight: 700;
      font-family: var(--font-mono);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    }
    .ch-pill:hover, .ch-pill:active {
      background: var(--ch-accent, var(--text-main));
      color: #06070b;
      transform: translateY(-1px);
      box-shadow: 0 4px 16px -2px var(--ch-accent, rgba(255,255,255,0.3));
    }
    .ch-pill.master-pill {
      padding: 0 15px;
      font-size: 0.66rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border-color: rgba(251, 191, 36, 0.45);
      color: var(--accent-master);
    }
    .ch-pill.master-pill:hover { background: var(--accent-master); color: #06070b; box-shadow: 0 4px 16px -2px var(--accent-master); }

    /* ---------- Layout ---------- */
    main {
      width: 100%;
      max-width: 1900px;
      margin: 0 auto;
      padding: 20px;
      display: grid;
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 18px;
      align-items: start;
      flex-grow: 1;
    }

    #channelsContainer {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
      gap: 18px;
      align-items: start;
    }

    /* ---------- Panels ---------- */
    .panel {
      position: relative;
      min-width: 0;
      max-width: none;
      border-radius: var(--radius-lg);
      padding: 16px 15px 18px;
      background:
        radial-gradient(120% 80% at 50% -20%, rgba(255, 255, 255, 0.06), transparent 60%),
        linear-gradient(165deg, var(--panel-bg-1), var(--panel-bg-2));
      border: 1px solid var(--border);
      box-shadow: 0 24px 50px -30px rgba(0, 0, 0, 0.95), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .panel:hover {
      border-color: var(--border-highlight);
      transform: translateY(-2px);
      box-shadow: 0 30px 60px -32px rgba(0, 0, 0, 1), inset 0 1px 0 rgba(255, 255, 255, 0.07);
    }

    #masterPanel {
      background:
        radial-gradient(140% 60% at 50% -10%, rgba(251, 191, 36, 0.10), transparent 70%),
        linear-gradient(165deg, #191b25, #0d0f16);
      border-color: rgba(251, 191, 36, 0.20);
    }

    .channel-strip { scroll-margin-left: 20px; }

    .channel-strip::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--ch-accent, var(--accent-route)) 18%, var(--ch-accent, var(--accent-route)) 82%, transparent);
      box-shadow: 0 0 18px var(--ch-accent);
      opacity: 0.85;
    }
    #masterPanel::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--accent-master) 18%, var(--accent-master) 82%, transparent);
      box-shadow: 0 0 18px var(--accent-master);
      opacity: 0.85;
    }

    .panel h2, .panel h3 { text-align: center; font-weight: 700; margin: 0 0 14px 0; }

    .panel h2 {
      font-size: 0.86rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-main);
      margin-top: 4px;
    }
    #masterPanel h2 { color: var(--accent-master); letter-spacing: 0.18em; }

    .channel-strip h2 {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: 0.92rem;
    }

    .ch-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: var(--ch-accent, var(--accent-route));
      color: #06070b;
      font-weight: 800;
      font-size: 0.76rem;
      font-family: var(--font-mono);
      box-shadow: 0 0 16px -2px var(--ch-accent);
      margin-right: 0;
    }

    #masterPanel h3, .module-title {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 7px;
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--text-dim);
      margin: 18px 0 9px;
      padding-top: 13px;
      border-top: 1px solid var(--border);
      font-family: var(--font-mono);
      font-weight: 600;
    }
    #masterPanel h3:first-of-type, .module-title:first-child { margin-top: 8px; }
    .module-title svg { flex: 0 0 auto; width: 15px; height: 15px; opacity: 0.9; }
    .module-title.eq-title svg     { stroke: var(--accent-eq); }
    .module-title.route-title svg  { stroke: var(--accent-route); }
    .module-title.reverb-title svg { stroke: var(--accent-reverb); }
    .module-title.comp-title svg   { stroke: var(--accent-comp); }

    /* ---------- Collapsible Sections ---------- */
    details.ctrl-section {
      margin-top: 14px;
      background: rgba(0, 0, 0, 0.22);
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border);
    }
    details.ctrl-section > summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-main);
      padding: 11px 13px;
      user-select: none;
      transition: background 0.15s ease;
    }
    details.ctrl-section > summary::-webkit-details-marker { display: none; }
    details.ctrl-section > summary:hover { background: rgba(255, 255, 255, 0.04); }
    details.ctrl-section > summary svg { width: 15px; height: 15px; flex: 0 0 auto; }
    details.ctrl-section > summary .chev {
      margin-left: auto;
      width: 7px;
      height: 7px;
      border-right: 1.5px solid var(--text-dim);
      border-bottom: 1.5px solid var(--text-dim);
      transform: rotate(-45deg);
      transition: transform 0.25s ease;
    }
    details[open].ctrl-section > summary .chev { transform: rotate(45deg); }
    .section-body { padding: 4px 10px 12px; }
    .comp-section summary svg { stroke: var(--accent-comp); }

    /* ---------- Graphic EQ ---------- */
    .eq-grid {
      display: flex;
      gap: 3px;
      justify-content: space-between;
      overflow-x: auto;
      padding: 6px 0 6px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .eq-grid::-webkit-scrollbar { display: none; }
    .eq-hint {
      font-size: 0.58rem;
      color: var(--text-dim);
      text-align: center;
      margin: 2px 0 2px;
      opacity: 0.6;
      font-family: var(--font-mono);
      letter-spacing: 0.02em;
    }

    .fader-unit { display: flex; flex-direction: column; align-items: center; gap: 5px; flex: 0 0 auto; }

    .fader-unit .value, .knob-unit .value {
      font-size: 0.62rem;
      font-family: var(--font-mono);
      color: var(--text-main);
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 6px;
      padding: 2px 5px;
      min-width: 30px;
      text-align: center;
      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.6);
    }
    .knob-unit .value { min-width: 36px; }

    .fader-unit .fader-label {
      font-size: 0.56rem;
      color: var(--text-dim);
      font-family: var(--font-mono);
      white-space: nowrap;
      letter-spacing: 0.02em;
    }

    .fader-track-wrap { position: relative; width: 26px; }
    .eq-grid .fader-track-wrap { height: 96px; }
    .main-fader-wrap .fader-track-wrap,
    .master-fader-wrap .fader-track-wrap { height: 168px; width: 36px; }

    .v-fader {
      -webkit-appearance: none;
      appearance: none;
      position: absolute;
      top: 50%;
      left: 50%;
      margin: 0;
      background: transparent;
      cursor: pointer;
      touch-action: none;
    }
    .eq-grid .v-fader { width: 96px; height: 24px; transform: translate(-50%, -50%) rotate(-90deg); }
    .main-fader-wrap .v-fader,
    .master-fader-wrap .v-fader { width: 168px; height: 30px; transform: translate(-50%, -50%) rotate(-90deg); }

    .v-fader::-webkit-slider-runnable-track {
      height: 4px;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.14));
      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.8);
    }
    .v-fader.eq-fader::-webkit-slider-runnable-track {
      background:
        linear-gradient(to right, transparent calc(50% - 0.5px), rgba(255, 255, 255, 0.35) calc(50% - 0.5px), rgba(255, 255, 255, 0.35) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
        linear-gradient(90deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.12));
    }
    .v-fader::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 12px;
      height: 24px;
      border-radius: 4px;
      background: linear-gradient(180deg, #f8fafc, #c7cfdb);
      border: 1px solid rgba(0, 0, 0, 0.35);
      box-shadow: inset 0 3px 0 var(--thumb, #94a3b8), 0 2px 6px rgba(0, 0, 0, 0.65);
      margin-top: -10px;
      cursor: grab;
      transition: box-shadow 0.15s ease;
    }
    .v-fader::-webkit-slider-thumb:hover { box-shadow: inset 0 3px 0 var(--thumb, #94a3b8), 0 0 0 3px var(--thumb-glow, rgba(148, 163, 184, 0.25)), 0 2px 6px rgba(0, 0, 0, 0.65); }
    .v-fader::-webkit-slider-thumb:active { cursor: grabbing; }
    .main-fader-wrap .v-fader::-webkit-slider-thumb,
    .master-fader-wrap .v-fader::-webkit-slider-thumb { width: 16px; height: 30px; margin-top: -13px; border-radius: 5px; }

    .v-fader::-moz-range-track {
      height: 4px;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.14));
    }
    .v-fader.eq-fader::-moz-range-track {
      background:
        linear-gradient(to right, transparent calc(50% - 0.5px), rgba(255, 255, 255, 0.35) calc(50% - 0.5px), rgba(255, 255, 255, 0.35) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
        linear-gradient(90deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.12));
    }
    .v-fader::-moz-range-thumb {
      width: 12px;
      height: 24px;
      border-radius: 4px;
      background: linear-gradient(180deg, #f8fafc, #c7cfdb);
      border: 1px solid rgba(0, 0, 0, 0.35);
      box-shadow: inset 0 3px 0 var(--thumb, #94a3b8), 0 2px 6px rgba(0, 0, 0, 0.65);
      cursor: grab;
    }
    .main-fader-wrap .v-fader::-moz-range-thumb,
    .master-fader-wrap .v-fader::-moz-range-thumb { width: 16px; height: 30px; border-radius: 5px; }

    .master-row { --thumb: var(--accent-master); --thumb-glow: var(--accent-master-glow); }
    .eq-row     { --thumb: var(--accent-eq);     --thumb-glow: var(--accent-eq-glow); }
    .route-row  { --thumb: var(--accent-route);  --thumb-glow: var(--accent-route-glow); }
    .reverb-row { --thumb: var(--accent-reverb); --thumb-glow: var(--accent-reverb-glow); }
    .comp-row   { --thumb: var(--accent-comp);   --thumb-glow: var(--accent-comp-glow); }

    .fader-block { display: flex; justify-content: center; align-items: flex-end; gap: 26px; margin-top: 4px; }
    .main-fader-wrap, .master-fader-wrap { display: flex; flex-direction: column; align-items: center; gap: 8px; }

    .fader-scale {
      position: absolute;
      left: -8px;
      top: 4px;
      bottom: 4px;
      width: 5px;
      background-image: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.22) 0, rgba(255, 255, 255, 0.22) 1px, transparent 1px, transparent 25%);
      opacity: 0.8;
    }

    /* ---------- Knobs ---------- */
    .knob-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(52px, 1fr));
      gap: 16px 8px;
      padding: 8px 2px 2px;
    }
    .knob-unit { display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .knob-label {
      font-size: 0.58rem;
      color: var(--text-dim);
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      text-align: center;
    }
    .knob {
      position: relative;
      width: 46px;
      height: 46px;
      cursor: grab;
      touch-action: none;
      outline: none;
    }
    .knob:active { cursor: grabbing; }
    .knob:focus-visible .knob-body { box-shadow: 0 0 0 3px var(--thumb-glow, rgba(56, 189, 248, 0.35)), 0 4px 10px rgba(0, 0, 0, 0.6); }
    .knob.active .knob-body { box-shadow: 0 0 0 4px var(--thumb-glow, rgba(56, 189, 248, 0.4)), 0 4px 10px rgba(0, 0, 0, 0.6); }

    .knob-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: conic-gradient(from -135deg,
        var(--thumb, #94a3b8) 0deg,
        var(--thumb, #94a3b8) calc(var(--pct, 0) * 270deg),
        rgba(255, 255, 255, 0.08) calc(var(--pct, 0) * 270deg) 270deg,
        transparent 270deg 360deg);
      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 4px));
      mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 4px));
    }
    .knob-body {
      position: absolute;
      inset: 6px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 34% 26%, rgba(255, 255, 255, 0.16), transparent 45%),
        radial-gradient(circle at 50% 60%, #2a2f3b, #12151c 78%);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.10), inset 0 -3px 6px rgba(0, 0, 0, 0.5);
      transform: rotate(calc(-135deg + var(--pct, 0) * 270deg));
      transition: box-shadow 0.15s ease;
    }
    .knob-pointer {
      position: absolute;
      top: 3px;
      left: 50%;
      width: 2px;
      height: 38%;
      background: var(--thumb, #94a3b8);
      border-radius: 999px;
      transform: translateX(-50%);
      box-shadow: 0 0 6px var(--thumb, #94a3b8);
    }

    /* ---------- VU Meters ---------- */
    .vu-container { display: flex; justify-content: center; gap: 16px; margin: 12px 0 6px; }
    .vu-wrapper { display: flex; flex-direction: column; align-items: center; gap: 7px; }

    .vu {
      width: 12px;
      height: 150px;
      background: #05060a;
      border-radius: 999px;
      position: relative;
      overflow: hidden;
      box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.9), 0 0 0 1px var(--border);
    }
    .vu-fill {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 0%;
      background: linear-gradient(to top,
        #22c55e 0%, #4ade80 42%,
        #facc15 66%, #f59e0b 82%,
        #f87171 94%, #ef4444 100%);
      transition: height 0.08s ease-out;
      z-index: 1;
      box-shadow: 0 0 12px rgba(74, 222, 128, 0.35);
    }
    .vu::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 5px, rgba(5, 6, 10, 0.85) 5px, rgba(5, 6, 10, 0.85) 7px);
      z-index: 2;
      pointer-events: none;
    }
    .vu-caption {
      font-size: 0.6rem;
      color: var(--text-dim);
      font-family: var(--font-mono);
      font-weight: 600;
      letter-spacing: 0.06em;
    }

    .info-box {
      font-size: 0.66rem;
      line-height: 1.55;
      color: var(--text-dim);
      background: rgba(56, 189, 248, 0.05);
      padding: 11px 12px;
      border-radius: var(--radius-md);
      border: 1px solid rgba(56, 189, 248, 0.16);
      margin-top: 18px;
      text-align: center;
    }
    .info-box b { color: var(--text-main); }

    /* ---------- Responsive ---------- */
    @media (max-width: 1180px) {
      main { grid-template-columns: 288px minmax(0, 1fr); gap: 16px; padding: 16px; }
      #channelsContainer { grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
    }

    @media (max-width: 900px) {
      main {
        display: flex;
        flex-direction: row;
        gap: 14px;
        padding: 14px;
        overflow-x: auto;
        align-items: flex-start;
        scroll-snap-type: x mandatory;
        scroll-padding: 14px;
      }
      #masterPanel, .channel-strip {
        flex: 0 0 auto;
        min-width: 84vw;
        max-width: 84vw;
        scroll-margin-left: 14px;
      }
      #channelsContainer { display: contents; }
      .channel-nav { padding: 9px 14px; }
      .panel:hover { transform: none; }
    }

    @media (max-width: 480px) {
      header { padding: 0 14px; }
      .brand-text .title { font-size: 0.9rem; }
      #masterPanel, .channel-strip { min-width: 90vw; max-width: 90vw; }
    }

    @media (max-width: 640px) {
      header { padding: 0 12px; gap: 8px; }
      .brand { gap: 9px; }
      .brand-icon { width: 32px; height: 32px; }
      .brand-text .title { font-size: 0.88rem; }
      .brand-text .subtitle { font-size: 0.55rem; letter-spacing: 0.12em; }
      .status { padding: 6px 10px; font-size: 0.64rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .vu-fill { transition: none; }
      .status.ws-connected::before { animation: none; }
      .panel { transition: none; }
    }

    /* ---- License gate ---- */
    .lic-overlay {
      position: fixed; inset: 0; z-index: 9999; display: flex;
      align-items: center; justify-content: center; padding: 20px;
      background: rgba(3, 4, 8, 0.82); backdrop-filter: blur(8px);
    }
    .lic-overlay[hidden] { display: none; }
    .lic-card {
      width: min(470px, 100%); max-height: 92vh; overflow: auto;
      border-radius: 18px; padding: 22px;
      background: linear-gradient(165deg, #161b28, #0a0c13);
      border: 1px solid rgba(56, 189, 248, 0.25);
      box-shadow: 0 40px 80px -30px #000, 0 0 50px -25px rgba(56, 189, 248, 0.7),
                  inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .lic-kicker {
      font: 700 0.6rem var(--font-mono); letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--danger);
    }
    .lic-card h2 { margin: 5px 0 8px; font-size: 1.35rem; letter-spacing: -0.02em; }
    .lic-card p { color: var(--text-dim); font-size: 0.78rem; line-height: 1.55; margin: 0 0 14px; }
    .lic-row {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      padding: 9px 0; border-bottom: 1px dashed var(--border);
      font-size: 0.72rem; color: var(--text-dim);
    }
    .lic-row b { font-family: var(--font-mono); font-weight: 600; color: var(--text-main); }
    .lic-card label {
      display: block; margin: 14px 0 5px; font-size: 0.66rem; color: var(--text-dim);
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    .lic-card textarea {
      width: 100%; min-height: 70px; resize: vertical; padding: 10px;
      border-radius: 9px; border: 1px solid var(--border); background: rgba(0, 0, 0, 0.35);
      color: var(--text-main); font: 500 0.7rem var(--font-mono);
    }
    .lic-btn {
      margin-top: 12px; padding: 10px 14px; border-radius: 9px; border: 0;
      cursor: pointer; font: 700 0.7rem var(--font-body); color: #04060a;
      background: linear-gradient(135deg, var(--accent-route), #818cf8);
      box-shadow: 0 10px 24px -12px rgba(56, 189, 248, 0.9);
    }
    .lic-btn.secondary {
      color: var(--text-main); background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border); box-shadow: none;
    }
    .lic-btn:disabled { opacity: 0.55; cursor: wait; }
    .lic-msg { min-height: 1em; margin-top: 9px; font-size: 0.7rem; }
    .lic-msg.err { color: var(--danger); }
    .lic-msg.ok { color: var(--success); }
    .lic-get { margin-top: 16px; padding-top: 12px; border-top: 1px dashed var(--border); }
    .lic-url { display: flex; gap: 8px; margin-top: 6px; }
    .lic-url input {
      flex: 1; min-width: 0; padding: 9px; border-radius: 8px;
      border: 1px solid var(--border); background: rgba(0, 0, 0, 0.35);
      color: #c7e9ff; font: 500 0.64rem var(--font-mono);
    }
    .lic-note { margin-top: 10px; font-size: 0.64rem; color: var(--text-dim); line-height: 1.5; }
  </style>
</head>
<body>
<header>
  <div class="brand">
    <div class="brand-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round">
        <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><circle cx="4" cy="12" r="2.5" fill="currentColor" stroke="none"/>
        <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><circle cx="12" cy="10" r="2.5" fill="currentColor" stroke="none"/>
        <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><circle cx="20" cy="14" r="2.5" fill="currentColor" stroke="none"/>
      </svg>
    </div>
    <div class="brand-text">
      <div class="title">ESP32-P4 DSP Console</div>
      <div class="subtitle">8 Channel Digital Mixer</div>
    </div>
  </div>
  <div class="status" id="wsStatus">WS: Wait...</div>
</header>

<nav class="channel-nav" id="channelNav" aria-label="Navigasi channel"></nav>

<main>
  <div class="panel" id="masterPanel">
    <h2>MASTER BUS</h2>

    <div class="vu-container">
      <div class="vu-wrapper">
        <div class="vu" data-vu="masterL"><div class="vu-fill"></div></div>
        <div class="vu-caption">MAIN L</div>
      </div>
      <div class="vu-wrapper">
        <div class="vu" data-vu="masterR"><div class="vu-fill"></div></div>
        <div class="vu-caption">MAIN R</div>
      </div>
    </div>

    <h3>Main Output Fader</h3>
    <div class="fader-block">
      <div class="master-fader-wrap fader-unit master-row">
        <span class="value">0.80</span>
        <div class="fader-track-wrap">
          <div class="fader-scale"></div>
          <input type="range" class="v-fader" min="0" max="1" step="0.01" value="0.8" data-master="lrL" aria-label="Master Out L">
        </div>
        <span class="fader-label">OUT&nbsp;L</span>
      </div>
      <div class="master-fader-wrap fader-unit master-row">
        <span class="value">0.80</span>
        <div class="fader-track-wrap">
          <div class="fader-scale"></div>
          <input type="range" class="v-fader" min="0" max="1" step="0.01" value="0.8" data-master="lrR" aria-label="Master Out R">
        </div>
        <span class="fader-label">OUT&nbsp;R</span>
      </div>
    </div>

    <h3>Sub Groups &amp; Aux</h3>
    <div class="knob-grid" id="masterSendsGrid"></div>

    <h3>Bus Meters</h3>
    <div class="vu-container" style="gap:15px; margin-top:10px;">
      <div class="vu-wrapper"><div class="vu" style="height:100px;" data-vu="group1"><div class="vu-fill"></div></div><div class="vu-caption">GRP1</div></div>
      <div class="vu-wrapper"><div class="vu" style="height:100px;" data-vu="group2"><div class="vu-fill"></div></div><div class="vu-caption">GRP2</div></div>
      <div class="vu-wrapper"><div class="vu" style="height:100px;" data-vu="aux1"><div class="vu-fill"></div></div><div class="vu-caption">AUX1</div></div>
      <div class="vu-wrapper"><div class="vu" style="height:100px;" data-vu="aux2"><div class="vu-fill"></div></div><div class="vu-caption">AUX2</div></div>
    </div>

    <div class="info-box">
      <b>Info Routing:</b> Slider UI mengontrol pemrosesan DSP internal di ESP. Jalur audio analog dikonfigurasi melalui PCM1808/PCM5102.
    </div>
  </div>

  <div id="channelsContainer"></div>
</main>

<div class="lic-overlay" id="licOverlay" hidden>
  <div class="lic-card">
    <div class="lic-kicker">License required</div>
    <h2>TRIAL ENDED</h2>
    <p>The 6-hour trial has ended. Enter an activation key bound to this mixer
       to unlock audio and controls.</p>

    <div class="lic-row"><span>Device ID (MAC)</span><b id="licDevice">...</b></div>
    <div class="lic-row"><span>Status</span><b id="licStatus">TRIAL ENDED</b></div>

    <label for="licKey">Activation key</label>
    <textarea id="licKey" placeholder="Paste the long activation key"
              spellcheck="false" autocomplete="off"></textarea>
    <button class="lic-btn" id="licActivate" type="button">Activate</button>
    <div class="lic-msg" id="licMsg"></div>

    <div class="lic-get">
      <label>Get a license key</label>
      <div class="lic-url">
        <input id="licUrl" readonly value="https://embedded-devlicense.esp32dev-by-shd.workers.dev/p4mix">
        <button class="lic-btn secondary" type="button" id="licCopy">Copy link</button>
      </div>
      <p class="lic-note">Disconnect from this Wi-Fi, open the link with mobile
         data, order your key, then reconnect and paste it above.</p>
    </div>
  </div>
</div>

<script>
  const NUM_CHANNELS = 8;
  const NUM_EQ_BANDS = 15;

  const ICONS = {
    eq: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-4h6m2-4h6"/></svg>',
    route: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h6l3-7 3 14 3-7h3"/></svg>',
    reverb: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12v.01M8 12v.01M12 12v.01M16 12v.01M20 12v.01M4 8a16 16 0 0 1 16 0"/></svg>',
    comp: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M8 12h8m-4-4v8"/></svg>'
  };

  const state = {
    master: { lrL: 0.8, lrR: 0.8, group1: 0.8, group2: 0.8, aux1: 0.8, aux2: 0.8 },
    channels: Array.from({ length: NUM_CHANNELS }, () => ({
      eq: new Array(NUM_EQ_BANDS).fill(0.0),
      send: { lr: 1.0, group1: 0.0, group2: 0.0, aux1: 0.0, aux2: 0.0 },
      reverb: 0.0,
      comp: { ratio: 2.0, attack: 10.0, release: 200.0, threshold: -20.0, gain: 0.0 }
    }))
  };

  const channelsContainer = document.getElementById('channelsContainer');
  const channelNav = document.getElementById('channelNav');

  // ================== Widget: Vertical Fader ==================
  // Native <input type=range>, rotated -90deg -> min at bottom, max at top,
  // exactly like a real mixing-console channel fader.
  function createFaderUnit(labelText, min, max, step, initValue, onChange, rowClass, opts) {
    opts = opts || {};
    const wrap = document.createElement('div');
    wrap.className = 'fader-unit ' + (rowClass || '') + (opts.big ? ' ' + (opts.wrapClass || 'main-fader-wrap') : '');

    const valueEl = document.createElement('span');
    valueEl.className = 'value';
    valueEl.textContent = initValue.toFixed((max - min > 2) ? 0 : 2);

    const trackWrap = document.createElement('div');
    trackWrap.className = 'fader-track-wrap';
    if (opts.scale) {
      const scale = document.createElement('div');
      scale.className = 'fader-scale';
      trackWrap.appendChild(scale);
    }

    const input = document.createElement('input');
    input.type = 'range';
    input.className = 'v-fader' + (opts.eq ? ' eq-fader' : '');
    input.min = min; input.max = max; input.step = step; input.value = initValue;
    input.setAttribute('aria-label', labelText);
    trackWrap.appendChild(input);

    const label = document.createElement('span');
    label.className = 'fader-label';
    label.textContent = labelText;

    input.addEventListener('input', () => {
      const v = parseFloat(input.value);
      valueEl.textContent = (max - min > 2) ? v.toFixed(0) : v.toFixed(2);
      onChange(v);
      scheduleSend();
    });

    wrap.append(valueEl, trackWrap, label);
    return wrap;
  }

  // ================== Widget: Rotary Knob ==================
  // Custom knob control: drag vertically (mouse/touch/pen via Pointer Events)
  // or use arrow keys / mouse wheel. Mirrors the aux-send / dynamics knobs
  // found on real mixer channel strips.
  function createKnob(labelText, min, max, step, initValue, onChange, rowClass) {
    const wrap = document.createElement('div');
    wrap.className = 'knob-unit ' + (rowClass || '');

    const label = document.createElement('span');
    label.className = 'knob-label';
    label.textContent = labelText;

    const knob = document.createElement('div');
    knob.className = 'knob';
    knob.tabIndex = 0;
    knob.setAttribute('role', 'slider');
    knob.setAttribute('aria-label', labelText);
    knob.setAttribute('aria-valuemin', min);
    knob.setAttribute('aria-valuemax', max);

    const ring = document.createElement('div'); ring.className = 'knob-ring';
    const body = document.createElement('div'); body.className = 'knob-body';
    const pointer = document.createElement('div'); pointer.className = 'knob-pointer';
    body.appendChild(pointer);
    knob.append(ring, body);

    const valueEl = document.createElement('span');
    valueEl.className = 'value';

    let value = initValue;
    const decimals = (max - min > 2) ? 0 : 2;
    const range = max - min;
    const sensitivity = 130; // px of vertical drag for full sweep

    function render() {
      const pct = (value - min) / range;
      knob.style.setProperty('--pct', pct.toFixed(4));
      valueEl.textContent = value.toFixed(decimals);
      knob.setAttribute('aria-valuenow', value.toFixed(decimals));
    }
    render();

    function setValue(v, fire) {
      v = Math.min(max, Math.max(min, v));
      v = Math.round(v / step) * step;
      v = parseFloat(v.toFixed(6));
      if (v === value) return;
      value = v;
      render();
      if (fire !== false) { onChange(value); scheduleSend(); }
    }

    let dragging = false, startY = 0, startVal = 0;

    knob.addEventListener('pointerdown', (e) => {
      dragging = true;
      startY = e.clientY;
      startVal = value;
      knob.setPointerCapture(e.pointerId);
      knob.classList.add('active');
      knob.focus();
    });
    knob.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dy = startY - e.clientY;
      setValue(startVal + (dy / sensitivity) * range);
    });
    function endDrag() { dragging = false; knob.classList.remove('active'); }
    knob.addEventListener('pointerup', endDrag);
    knob.addEventListener('pointercancel', endDrag);

    knob.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowRight') { setValue(value + step); e.preventDefault(); }
      else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') { setValue(value - step); e.preventDefault(); }
    });
    knob.addEventListener('wheel', (e) => {
      e.preventDefault();
      setValue(value + (e.deltaY < 0 ? step : -step));
    }, { passive: false });

    wrap.append(label, knob, valueEl);
    return wrap;
  }

  function createModuleTitle(text, iconKey, titleClass) {
    const h = document.createElement('h3');
    h.className = 'module-title ' + (titleClass || '');
    h.innerHTML = (ICONS[iconKey] || '') + '<span>' + text + '</span>';
    return h;
  }

  function createChannelStrip(chIndex) {
    const panel = document.createElement('div');
    panel.className = 'panel channel-strip';
    panel.id = 'channel-' + chIndex;
    const hue = Math.round((360 / NUM_CHANNELS) * chIndex);
    panel.style.setProperty('--ch-accent', `hsl(${hue}, 85%, 60%)`);

    const title = document.createElement('h2');
    title.innerHTML = `<span class="ch-badge">${chIndex + 1}</span> CH ${chIndex + 1}`;
    panel.appendChild(title);

    // ---- Meter ----
    const vuContainer = document.createElement('div');
    vuContainer.className = 'vu-container';
    vuContainer.innerHTML = `<div class="vu-wrapper"><div class="vu" data-vu="ch${chIndex}"><div class="vu-fill"></div></div><div class="vu-caption">LEVEL</div></div>`;
    panel.appendChild(vuContainer);

    // ---- Graphic EQ (always visible - this IS the mixer's signature look) ----
    panel.appendChild(createModuleTitle('Graphic EQ 15-Band', 'eq', 'eq-title'));
    const eqGrid = document.createElement('div');
    eqGrid.className = 'eq-grid';
    const freqs = [31, 63, 125, 250, 500, 1000, 2000, 4000, 6000, 8000, 10000, 12000, 14000, 16000, 18000];
    freqs.forEach((f, idx) => {
      eqGrid.appendChild(createFaderUnit(
        f < 1000 ? `${f}` : `${f / 1000}k`,
        -12, 12, 0.5, 0.0,
        (val) => state.channels[chIndex].eq[idx] = val,
        'eq-row',
        { eq: true }
      ));
    });
    panel.appendChild(eqGrid);
    const hint = document.createElement('div');
    hint.className = 'eq-hint';
    hint.textContent = '\u2190 geser untuk lihat semua band \u2192';
    panel.appendChild(hint);

    // ---- Sends & FX (knobs) ----
    panel.appendChild(createModuleTitle('Sends &amp; FX', 'route', 'route-title'));
    const sendGrid = document.createElement('div');
    sendGrid.className = 'knob-grid';
    const sendDefs = [
      { lbl: 'Grp 1', key: 'group1', init: 0.0 },
      { lbl: 'Grp 2', key: 'group2', init: 0.0 },
      { lbl: 'Aux 1', key: 'aux1', init: 0.0 },
      { lbl: 'Aux 2', key: 'aux2', init: 0.0 }
    ];
    sendDefs.forEach(d => {
      sendGrid.appendChild(createKnob(d.lbl, 0, 1, 0.01, d.init,
        v => state.channels[chIndex].send[d.key] = v, 'route-row'));
    });
    sendGrid.appendChild(createKnob('Reverb', 0, 1, 0.01, 0.0,
      v => state.channels[chIndex].reverb = v, 'reverb-row'));
    panel.appendChild(sendGrid);

    // ---- Dynamics (collapsible - advanced processing, tucked away like an insert module) ----
    const compDetails = document.createElement('details');
    compDetails.className = 'ctrl-section comp-section';
    const compSummary = document.createElement('summary');
    compSummary.innerHTML = ICONS.comp + '<span>Dynamics (Compressor)</span><span class="chev"></span>';
    const compBody = document.createElement('div');
    compBody.className = 'section-body';
    const compGrid = document.createElement('div');
    compGrid.className = 'knob-grid';
    const compParams = [
      { lbl: 'Ratio', min: 1, max: 10, step: 0.1, init: 2.0, key: 'ratio' },
      { lbl: 'Attack', min: 0, max: 100, step: 1, init: 10, key: 'attack' },
      { lbl: 'Release', min: 10, max: 1000, step: 10, init: 200, key: 'release' },
      { lbl: 'Thresh', min: -60, max: 0, step: 1, init: -20, key: 'threshold' },
      { lbl: 'Makeup', min: -12, max: 12, step: 0.5, init: 0, key: 'gain' }
    ];
    compParams.forEach(p => {
      compGrid.appendChild(createKnob(p.lbl, p.min, p.max, p.step, p.init,
        v => state.channels[chIndex].comp[p.key] = v, 'comp-row'));
    });
    compBody.appendChild(compGrid);
    compDetails.append(compSummary, compBody);
    panel.appendChild(compDetails);

    // ---- Channel fader (the hero control, always visible at the bottom) ----
    panel.appendChild(createModuleTitle('Channel Fader', 'route', 'route-title'));
    const faderBlock = document.createElement('div');
    faderBlock.className = 'fader-block';
    faderBlock.appendChild(createFaderUnit('TO L/R', 0, 1, 0.01, 1.0,
      v => state.channels[chIndex].send.lr = v, 'route-row',
      { big: true, wrapClass: 'main-fader-wrap', scale: true }));
    panel.appendChild(faderBlock);

    return panel;
  }

  // Navigasi
  const masterPill = document.createElement('button');
  masterPill.className = 'ch-pill master-pill';
  masterPill.textContent = 'Master';
  masterPill.onclick = () => document.getElementById('masterPanel').scrollIntoView({ behavior: 'smooth', inline: 'start' });
  channelNav.appendChild(masterPill);

  for (let ch = 0; ch < NUM_CHANNELS; ch++) {
    channelsContainer.appendChild(createChannelStrip(ch));
    const pill = document.createElement('button');
    pill.className = 'ch-pill';
    pill.textContent = ch + 1;
    pill.style.setProperty('--ch-accent', `hsl(${Math.round(360 / NUM_CHANNELS * ch)}, 85%, 60%)`);
    pill.onclick = () => document.getElementById(`channel-${ch}`).scrollIntoView({ behavior: 'smooth', inline: 'start' });
    channelNav.appendChild(pill);
  }

  // Master Out L/R faders (native range inputs, matched via data-master)
  document.querySelectorAll('#masterPanel input[type=range]').forEach(input => {
    const key = input.dataset.master;
    input.value = state.master[key];
    const span = input.closest('.fader-unit').querySelector('.value');

    input.addEventListener('input', () => {
      const v = parseFloat(input.value);
      state.master[key] = v;
      span.textContent = v.toFixed(2);
      scheduleSend();
    });
  });

  // Master Group/Aux send knobs
  const masterSendsGrid = document.getElementById('masterSendsGrid');
  [
    { lbl: 'Group 1', key: 'group1' },
    { lbl: 'Group 2', key: 'group2' },
    { lbl: 'Aux 1', key: 'aux1' },
    { lbl: 'Aux 2', key: 'aux2' }
  ].forEach(d => {
    masterSendsGrid.appendChild(createKnob(d.lbl, 0, 1, 0.01, state.master[d.key],
      v => state.master[d.key] = v, 'master-row'));
  });

  let ws = null, sendTimer = null;

  function connectWS() {
    const statusEl = document.getElementById('wsStatus');
    // Use the address the page was opened from (AP 192.168.4.1, STA IP, ...).
    const wsHost = location.host || '192.168.4.1';
    ws = new WebSocket(`ws://${wsHost}/ws`);

    ws.onopen = () => {
      statusEl.textContent = 'WS: Connected';
      statusEl.className = 'status ws-connected';
      sendParams();
    };

    ws.onclose = () => {
      statusEl.textContent = 'WS: Disconnected';
      statusEl.className = 'status ws-disconnected';
      setTimeout(connectWS, 2000);
    };

    ws.onerror = () => {
      statusEl.textContent = 'WS: Error';
      statusEl.className = 'status ws-disconnected';
    };

    ws.onmessage = (ev) => {
      try {
        const msg = JSON.parse(ev.data);
        if (msg.type === 'vu') updateVuFromMsg(msg);
      } catch (e) {
        console.warn('WS Parsing Error:', e);
      }
    };
  }

  function scheduleSend() {
    if (sendTimer) clearTimeout(sendTimer);
    sendTimer = setTimeout(() => {
      if (ws?.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'set', master: state.master, channels: state.channels }));
      }
    }, 50);
  }

  function sendParams() { scheduleSend(); }

  // ================== License gate ==================
  function setLicenseUI(d) {
    const overlay = document.getElementById('licOverlay');
    const locked = !!d.locked;
    overlay.hidden = !locked;
    document.documentElement.style.overflow = locked ? 'hidden' : '';

    if (d.deviceId) document.getElementById('licDevice').textContent = d.deviceId;
    if (d.activationUrl) document.getElementById('licUrl').value = d.activationUrl;
    document.getElementById('licStatus').textContent = locked
      ? 'TRIAL ENDED'
      : (d.license === 'licensed' ? 'Licensed' : 'Active');
  }

  async function refreshLicense() {
    try {
      const r = await fetch('/api/status', { cache: 'no-store' });
      if (r.ok) setLicenseUI(await r.json());
    } catch (e) { /* device busy / rebooting */ }
  }

  async function activateLicense() {
    const keyEl = document.getElementById('licKey');
    const msg = document.getElementById('licMsg');
    const btn = document.getElementById('licActivate');
    const key = keyEl.value.trim();

    if (!key) {
      msg.className = 'lic-msg err';
      msg.textContent = 'Paste the activation key first.';
      return;
    }

    btn.disabled = true;
    msg.className = 'lic-msg';
    msg.textContent = 'Checking key...';

    try {
      const r = await fetch('/api/license/activate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key })
      });
      const d = await r.json();
      if (d.ok) {
        msg.className = 'lic-msg ok';
        msg.textContent = 'Activated. Thank you!';
        await refreshLicense();
      } else {
        msg.className = 'lic-msg err';
        msg.textContent = d.error || 'Invalid key for this device.';
      }
    } catch (e) {
      msg.className = 'lic-msg err';
      msg.textContent = 'Connection error. Stay connected to the mixer AP.';
    } finally {
      btn.disabled = false;
    }
  }

  document.getElementById('licActivate').onclick = activateLicense;
  document.getElementById('licCopy').onclick = async function () {
    const input = document.getElementById('licUrl');
    const btn = document.getElementById('licCopy');
    try {
      await navigator.clipboard.writeText(input.value);
    } catch (e) {
      input.select();
      document.execCommand('copy');
    }
    btn.textContent = 'Copied';
    setTimeout(function () { btn.textContent = 'Copy link'; }, 1200);
  };

  refreshLicense();
  setInterval(refreshLicense, 3000);

  function updateVuFromMsg(msg) {
    msg.channels?.forEach((val, idx) => {
      const vu = document.querySelector(`.vu[data-vu="ch${idx}"] .vu-fill`);
      if (vu) {
        let height = val * 100;
        vu.style.height = `${Math.min(Math.max(height, 0), 100).toFixed(1)}%`;
        if (height > 90) vu.style.boxShadow = "0 0 15px rgba(239, 68, 68, 0.8)";
        else vu.style.boxShadow = "0 0 10px rgba(16, 185, 129, 0.5)";
      }
    });

    const bus = msg.bus || {};
    ['masterL','masterR','group1','group2','aux1','aux2'].forEach(key => {
      const vu = document.querySelector(`.vu[data-vu="${key}"] .vu-fill`);
      if (vu && typeof bus[key] === 'number') {
        vu.style.height = `${(bus[key] * 100).toFixed(1)}%`;
      }
    });
  }

  connectWS();
</script>
</body>
</html>

